; NSIS Installer Script
; Generated by ExeForge HTML to Windows EXE Builder

!define PRODUCT_NAME "Chart2midi"
!define PRODUCT_VERSION "1.0.0"
!define PRODUCT_PUBLISHER "İdk"
!define PRODUCT_DIR_REGKEY "Software\Microsoft\Windows\CurrentVersion\App Paths\Chart2midi.exe"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Chart2midi"

SetCompressor lzma

!include "MUI2.nsh"

Name "Chart2midi ${PRODUCT_VERSION}"
OutFile "dist\Chart2midi-Setup-${PRODUCT_VERSION}.exe"
InstallDir "$PROGRAMFILES\Chart2midi"
InstallDirRegKey HKLM "${PRODUCT_DIR_REGKEY}" ""
ShowInstDetails show
ShowUnInstDetails show

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Section "MainSection" SEC01
  SetOutPath "$INSTDIR"
  SetOverwrite ifnewer
  File /r "dist\win-unpacked\*"
  CreateDirectory "$SMPROGRAMS\Chart2midi"
  CreateShortCut "$SMPROGRAMS\Chart2midi\Chart2midi.lnk" "$INSTDIR\Chart2midi.exe"
  CreateShortCut "$DESKTOP\Chart2midi.lnk" "$INSTDIR\Chart2midi.exe"
SectionEnd

Section -Post
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "${PRODUCT_DIR_REGKEY}" "" "$INSTDIR\Chart2midi.exe"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayName" "Chart2midi"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "UninstallString" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "DisplayVersion" "${PRODUCT_VERSION}"
  WriteRegStr HKLM "${PRODUCT_UNINST_KEY}" "Publisher" "İdk"
SectionEnd

Section Uninstall
  RMDir /r "$INSTDIR"
  Delete "$SMPROGRAMS\Chart2midi\Chart2midi.lnk"
  RMDir "$SMPROGRAMS\Chart2midi"
  Delete "$DESKTOP\Chart2midi.lnk"
  DeleteRegKey HKLM "${PRODUCT_UNINST_KEY}"
  DeleteRegKey HKLM "${PRODUCT_DIR_REGKEY}"
SectionEnd
